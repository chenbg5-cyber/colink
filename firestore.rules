rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /families/{familyCode} {
      // Family root doc: any auth user can read (for join validation) and write (for creating new family)
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /members/{memberId} {
        // Any auth user can read (needed for family recovery search)
        // Only the member themselves can write their own doc
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == memberId;
      }

      match /sharedData/{docId} {
        allow read, write: if request.auth != null &&
          exists(/databases/$(database)/documents/families/$(familyCode)/members/$(request.auth.uid));
      }

      match /notifications/{docId} {
        allow read, write: if request.auth != null &&
          exists(/databases/$(database)/documents/families/$(familyCode)/members/$(request.auth.uid));
      }

      match /pushTokens/{tokenId} {
        allow read: if request.auth != null &&
          exists(/databases/$(database)/documents/families/$(familyCode)/members/$(request.auth.uid));
        allow write: if request.auth != null && request.auth.uid == tokenId;
      }

      match /attachments/{taskId} {
        allow read, write: if request.auth != null &&
          exists(/databases/$(database)/documents/families/$(familyCode)/members/$(request.auth.uid));
      }
    }
  }
}
